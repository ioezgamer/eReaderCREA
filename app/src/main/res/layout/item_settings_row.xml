<?xml version="1.0" encoding="utf-8"?>
<!-- A tappable settings row: round icon, title, detail and a chevron. Fill it from code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:padding="20dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_status_circle"
        android:contentDescription="@null"
        android:padding="10dp"
        app:tint="?attr/colorOnPrimaryContainer" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <ImageView
        android:id="@+id/row_chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
