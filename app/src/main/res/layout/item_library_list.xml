<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/glass_fill_top"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/list_cover"
            android:layout_width="72dp"
            android:layout_height="108dp"
            android:background="?attr/colorSurfaceVariant"
            android:contentDescription="@string/cover_image"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Crea.Cover"
            tools:src="@drawable/cover" />

        <TextView
            android:id="@+id/list_format"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/bg_badge_format"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textAppearance="@style/TextAppearance.Crea.Badge"
            app:layout_constraintStart_toStartOf="@id/list_cover"
            app:layout_constraintTop_toTopOf="@id/list_cover"
            tools:text="EPUB" />

        <ImageView
            android:id="@+id/list_favorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/favorite_cd"
            android:padding="8dp"
            android:src="@drawable/ic_favorite_outline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/list_favorite"
            app:layout_constraintStart_toEndOf="@id/list_cover"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Cien años de soledad" />

        <TextView
            android:id="@+id/list_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/list_cover"
            app:layout_constraintTop_toBottomOf="@id/list_title"
            tools:text="Gabriel García Márquez" />

        <TextView
            android:id="@+id/list_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/list_cover"
            app:layout_constraintTop_toBottomOf="@id/list_author"
            tools:text="Una saga familiar en el pueblo de Macondo, entre lo real y lo mágico."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/list_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/list_cover"
            app:layout_constraintTop_toBottomOf="@id/list_summary"
            tools:text="38% leído · 3,1 MB" />

        <LinearLayout
            android:id="@+id/list_offline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/list_cover"
            app:layout_constraintTop_toBottomOf="@id/list_meta">

            <ImageView
                android:id="@+id/list_source_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_download_done"
                app:tint="@color/crea_green" />

            <TextView
                android:id="@+id/list_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/catalog_available_offline"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/crea_green" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/list_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:visibility="gone"
            app:indicatorColor="@color/crea_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/list_cover"
            app:layout_constraintTop_toBottomOf="@id/list_offline"
            app:trackCornerRadius="4dp"
            app:trackThickness="5dp"
            tools:progress="38"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
