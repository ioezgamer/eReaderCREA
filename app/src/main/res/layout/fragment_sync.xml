<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:padding="20dp"
        android:paddingBottom="@dimen/scroll_bottom_padding">

        <!-- Status -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/glass_fill_top"
            app:cardCornerRadius="28dp"
            app:strokeColor="@color/glass_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp">

                    <ImageView
                        android:id="@+id/sync_status_icon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_status_circle"
                        android:contentDescription="@null"
                        android:padding="20dp"
                        android:src="@drawable/ic_cloud_off"
                        app:tint="?attr/colorOnPrimaryContainer" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/sync_status_spinner"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="72dp"
                        app:trackThickness="4dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/sync_status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textStyle="bold"
                    tools:text="Biblioteca al día" />

                <TextView
                    android:id="@+id/sync_status_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Última sincronización: hace 2 minutos" />

                <TextView
                    android:id="@+id/sync_status_extra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="2 nuevos · 1 subido · 0 eliminados"
                    tools:visibility="visible" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/sync_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sync_primary_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="56dp"
                    android:text="@string/sync_connect_drive"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_sync" />

                <!-- Accounts outside CREA: a private folder in their own Drive -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sync_personal_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="52dp"
                    android:text="@string/sync_connect_personal"
                    android:visibility="gone"
                    app:cornerRadius="26dp"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/sync_personal_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/sync_personal_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Account and folder -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sync_folder_card"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/glass_fill"
            app:cardCornerRadius="24dp"
            app:strokeColor="@color/glass_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:id="@+id/sync_account_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_status_circle"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_person"
                        app:tint="?attr/colorOnPrimaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sync_account_label"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/sync_account_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="ezequiel@creanicaragua.org" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_folder_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sync_folder_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/sync_folder_detail"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sync_open_folder_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:minHeight="52dp"
                    android:text="@string/sync_open_folder"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_open_in_new" />

                <!-- Personal accounts: books already somewhere in their Drive, picked one by one -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sync_pick_books_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="52dp"
                    android:text="@string/sync_pick_books"
                    android:visibility="gone"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_cloud_done"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- How it works -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:text="@string/sync_what_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <include
            android:id="@+id/sync_step_1"
            layout="@layout/item_sync_step" />

        <include
            android:id="@+id/sync_step_2"
            layout="@layout/item_sync_step" />

        <include
            android:id="@+id/sync_step_3"
            layout="@layout/item_sync_step" />

        <include
            android:id="@+id/sync_step_4"
            layout="@layout/item_sync_step" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sync_disable_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="52dp"
            android:text="@string/sync_disable"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>
