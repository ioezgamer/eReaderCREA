<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/nav_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/navigation" />

    <!-- Liquid Glass navigation bar (Android 12+). Replaces the pill below when it is in use. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/liquid_nav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Compact glass pill: only the selected tab shows its name -->
    <LinearLayout
        android:id="@+id/nav_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glass_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/nav_bookshelf"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/title_bookshelf"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/nav_bookshelf_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_library"
                app:tint="@color/nav_item" />

            <TextView
                android:id="@+id/nav_bookshelf_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:duplicateParentState="true"
                android:text="@string/title_bookshelf"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/nav_item"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_online"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/title_online_catalog"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/nav_online_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_online"
                app:tint="@color/nav_item" />

            <TextView
                android:id="@+id/nav_online_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tab_online_catalog"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/nav_item"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_catalogs"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/title_catalogs"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/nav_catalogs_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_explore"
                app:tint="@color/nav_item" />

            <TextView
                android:id="@+id/nav_catalogs_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:duplicateParentState="true"
                android:text="@string/title_catalogs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/nav_item"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_community"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/title_community"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/nav_community_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_community"
                app:tint="@color/nav_item" />

            <TextView
                android:id="@+id/nav_community_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:duplicateParentState="true"
                android:text="@string/title_community"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/nav_item"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/title_settings"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/nav_settings_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/nav_item" />

            <TextView
                android:id="@+id/nav_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:duplicateParentState="true"
                android:text="@string/title_settings"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/nav_item"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
