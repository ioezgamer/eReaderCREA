<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/catalog_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold"
        tools:text="El principito" />

    <TextView
        android:id="@+id/catalog_sheet_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="2dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Antoine de Saint-Exupéry · EPUB · 1,2 MB" />

    <include
        android:id="@+id/catalog_sheet_read"
        layout="@layout/item_sheet_action" />

    <include
        android:id="@+id/catalog_sheet_save"
        layout="@layout/item_sheet_action" />

    <include
        android:id="@+id/catalog_sheet_cancel"
        layout="@layout/item_sheet_action" />
</LinearLayout>
