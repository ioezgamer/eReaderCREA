<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/community"
    app:startDestination="@+id/navigation_profile">

    <!-- "Perfil": what each reader has read; "Qué leen los demás" opens the community. -->
    <fragment
        android:id="@+id/navigation_profile"
        android:name="org.crea.reader.readers.ProfileFragment"
        android:label="@string/profile_title">
        <action
            android:id="@+id/action_profile_to_community"
            app:destination="@id/navigation_community" />
    </fragment>

    <fragment
        android:id="@+id/navigation_community"
        android:name="org.crea.reader.community.CommunityFragment"
        android:label="@string/title_community_screen"
        tools:layout="@layout/fragment_community" />
</navigation>
