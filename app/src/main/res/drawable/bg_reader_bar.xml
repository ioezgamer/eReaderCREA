<?xml version="1.0" encoding="utf-8"?>
<!--
  Reader top bar: a floating glass capsule, like the navigation bar of the main screens.
  ReaderActivity places it around the toolbar, below the status bar (whose height varies per device).
  A visible edge keeps it apart from a white page, where a white bar alone looks transparent.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/reader_bar_fill" />
    <stroke android:width="1dp" android:color="@color/reader_bar_stroke" />
    <corners android:radius="22dp" />
</shape>
